# ============================================================
# AUTONOMOUS INSURANCE CLAIMS PROCESSOR - ENVIRONMENT CONFIG
# Copy this file to .env and fill in your actual values
# ============================================================

# -------------------------------------------------------------
# API KEYS (Required)
# -------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Pinecone for RAG (policy documents, historical claims)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=insurance-claims-index

# Weather APIs (at least one required)
NOAA_API_KEY=optional-but-recommended
TOMORROW_IO_API_KEY=your-tomorrow-io-key
WEATHER_UNDERGROUND_API_KEY=optional

# ISO ClaimSearch (fraud detection - optional for demo)
ISO_CLAIMSEARCH_API_KEY=optional

# AWS S3 (audit trail document storage - optional for local dev)
AWS_ACCESS_KEY_ID=optional
AWS_SECRET_ACCESS_KEY=optional
AWS_REGION=us-east-1
S3_BUCKET_NAME=claims-audit-archive

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=insurance_claims_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-postgres-password
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/insurance_claims_db

# -------------------------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------------------------
APP_ENV=development  # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Claim processing thresholds
FAST_TRACK_THRESHOLD=5000
LARGE_LOSS_THRESHOLD=50000
AUTO_APPROVE_LIMIT=2500
SIU_REFERRAL_THRESHOLD=60

# OCR settings
OCR_MIN_CONFIDENCE=85

# Rate limits (requests per day)
NOAA_RATE_LIMIT=1000
PINECONE_RATE_LIMIT=10000

# -------------------------------------------------------------
# SECURITY
# -------------------------------------------------------------
SECRET_KEY=your-secret-key-for-jwt-generation-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | console

# -------------------------------------------------------------
# INSURER PROFILE (Default - can be overridden via API)
# -------------------------------------------------------------
INSURER_COMPANY_NAME=Default Insurance Co
INSURER_LINES_OF_BUSINESS=Auto,Property,Health,Liability
INSURER_STATES_LICENSED=TX,CA,NY,FL
